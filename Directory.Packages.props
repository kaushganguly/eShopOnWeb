<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <TargetFramework>net10.0</TargetFramework>
    <AspNetVersion>10.0.12</AspNetVersion>
    <SystemExtensionVersion>10.0.12</SystemExtensionVersion>
    <EntityFramworkCoreVersion>10.0.12</EntityFramworkCoreVersion>
    <VSCodeGeneratorVersion>10.0.2</VSCodeGeneratorVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Transitive pins: Microsoft.VisualStudio.Web.CodeGeneration.Design 10.0.2 (the latest
         available version) drags in NuGet.Packaging/NuGet.Protocol 6.12.1, which has a known
         low-severity "defense in depth" advisory (GHSA-g4vj-cjjj-v7hg) patched in 6.12.5.
         These packages are design-time-only (dotnet-aspnet-codegenerator scaffolding tool),
         never shipped at runtime, but are pinned up to the patched version regardless. -->
    <PackageVersion Include="NuGet.Packaging" Version="6.12.5" />
    <PackageVersion Include="NuGet.Protocol" Version="6.12.5" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Ardalis.ApiEndpoints" Version="4.1.0" />
    <PackageVersion Include="Ardalis.GuardClauses" Version="5.0.0" />
    <PackageVersion Include="Ardalis.Specification.EntityFrameworkCore" Version="9.3.1" />
    <PackageVersion Include="Ardalis.Result" Version="10.1.0" />
    <PackageVersion Include="Ardalis.Specification" Version="9.3.1" />
    <PackageVersion Include="Ardalis.ListStartupServices" Version="1.1.4" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <!-- AutoMapper: migrated from the retired AutoMapper.Extensions.Microsoft.DependencyInjection
         companion package to the core AutoMapper package (which has bundled DI registration via
         AddAutoMapper since v13). Bumped past 12.0.1 specifically to resolve a HIGH severity DoS
         vulnerability (GHSA-rvv3-g6hj-g44x, unbounded recursive mapping depth) patched in 15.1.1/16.1.1.
         NOTE: AutoMapper (like MediatR) introduced a commercial license tier starting at v13 for
         qualifying commercial use (see automapper.io) — flagged for legal/procurement review. -->
    <PackageVersion Include="AutoMapper" Version="16.2.0" />
    <PackageVersion Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageVersion Include="BuildBundlerMinifier" Version="3.2.449" PrivateAssets="All" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <!-- MediatR: pinned to the last Apache-2.0-licensed release (12.x line). v13+ requires a
         commercial license (mediatr.io) for commercial use — not auto-adopted during this upgrade. -->
    <PackageVersion Include="MediatR" Version="12.5.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="$(AspNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(AspNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="$(AspNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(AspNetVersion)" PrivateAssets="all" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="$(AspNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="$(AspNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(AspNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="$(AspNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.UI" Version="$(AspNetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="$(AspNetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Configuration" Version="$(SystemExtensionVersion)" />
    <PackageVersion Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="$(VSCodeGeneratorVersion)" />
    <PackageVersion Include="Microsoft.Web.LibraryManager.Build" Version="3.0.114" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="$(EntityFramworkCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(EntityFramworkCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="$(EntityFramworkCoreVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="MinimalApi.Endpoint" Version="1.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore.Annotations" Version="10.3.0" />
    <!-- Test -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(AspNetVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>
</Project>