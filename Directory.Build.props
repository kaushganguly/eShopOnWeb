<Project>
  <PropertyGroup>
    <!-- Default target framework for all projects. All projects now target net10.0 after the upgrade.
         Using Directory.Build.props (not Directory.Packages.props) so project-level TargetFramework
         overrides are not treated as global MSBuild properties. -->
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
</Project>
