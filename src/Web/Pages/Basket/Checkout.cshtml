@page
@model CheckoutModel
@{
    ViewData["Title"] = "Checkout";
}
<div class="esh-catalog-hero">
    <div class="container">
        <img class="esh-catalog-title" src="~/images/main_banner_text.png" />
    </div>
</div>

<div class="container">
    <h1>Review</h1>
    @if (Model.BasketModel.Items.Any())
    {
        <form asp-page="Checkout" method="post">
            <div class="esh-basket-titles row">
                <br />
                <div class="esh-basket-title col-xs-3">Product</div>
                <div class="esh-basket-title col-xs-3 hidden-lg-down"></div>
                <div class="esh-basket-title col-xs-2">Price</div>
                <div class="esh-basket-title col-xs-2">Quantity</div>
                <div class="esh-basket-title col-xs-2">Cost</div>
            </div>
            <div class="esh-catalog-items row">
                @Html.ValidationSummary(false, null, new { @class = "text-danger" })
                @for (int i = 0; i < Model.BasketModel.Items.Count; i++)
                {
                    var item = Model.BasketModel.Items[i];
                    <div class="esh-basket-items row">
                        <div>
                            <div class="esh-basket-item esh-basket-item--middle col-lg-3 hidden-lg-down">
                                <img class="esh-basket-image" src="@item.PictureUrl" />
                            </div>
                            <div class="esh-basket-item esh-basket-item--middle col-xs-3">@item.ProductName</div>
                            <div class="esh-basket-item esh-basket-item--middle col-xs-2">$ @item.UnitPrice.ToString("N2")</div>
                            <div class="esh-basket-item esh-basket-item--middle col-xs-2">
                                <input type="hidden" name="@("Items[" + i + "].Id")" value="@item.Id" />
                                <input type="hidden" name="@("Items[" + i + "].Quantity")" value="@item.Quantity" />
                                @item.Quantity
                            </div>
                            <div class="esh-basket-item esh-basket-item--middle esh-basket-item--mark col-xs-2">$ @Math.Round(item.Quantity * item.UnitPrice, 2).ToString("N2")</div>
                        </div>
                        <div class="row">

                        </div>
                    </div>
                }

                <div class="container">
                    <div class="esh-basket-titles esh-basket-titles--clean row">
                        <div class="esh-basket-title col-xs-10"></div>
                        <div class="esh-basket-title col-xs-2">Total</div>
                    </div>

                    <div class="esh-basket-items row">
                        <div class="esh-basket-item col-xs-10"></div>
                        <div class="esh-basket-item esh-basket-item--mark col-xs-2">$ @Model.BasketModel.Total().ToString("N2")</div>
                    </div>

                    <div class="esh-basket-items row">
                        <div class="esh-basket-item col-xs-7"></div>
                    </div>
                </div>
                <div class="row">
                    <div class="esh-basket-item col-xs-1">
                        <a asp-page="Index" class="btn esh-basket-checkout text-white">[ Back ]</a>
                    </div>
                    <div class="esh-basket-item col-xs-push-7 col-xs-4 text-right">
                        <input type="submit" class="btn esh-basket-checkout" value="[ Pay Now ]" />
                    </div>
                </div>
            </div>
        </form>
    }
    else
    {
        <h3 class="esh-catalog-items row">
            Basket is empty.
        </h3>

        <div class="esh-basket-item">
            <a asp-page="/Index" class="btn esh-basket-checkout text-white">[ Continue Shopping ]</a>
        </div>
    }
</div>