@model OrderDetailViewModel
@{
    ViewData["Title"] = "My Order History";
}
@{
    ViewData["Title"] = "Order Detail";
}

<div class="esh-orders-detail">
    <div class="container">
        <div class="esh-orders-detail-section">
            <div class="esh-orders-detail-titles row">
                <div class="esh-orders-detail-title col-xs-3">Order number</div>
                <div class="esh-orders-detail-title col-xs-3">Date</div>
                <div class="esh-orders-detail-title col-xs-2">Total</div>
                <div class="esh-orders-detail-title col-xs-3">Status</div>
            </div>

            <div class="esh-orders-detail-items row">
                <div class="esh-orders-detail-item col-xs-3">@Model.OrderNumber</div>
                <div class="esh-orders-detail-item col-xs-3">@Model.OrderDate</div>
                <div class="esh-orders-detail-item col-xs-2">$@Model.Total.ToString("N2")</div>
                <div class="esh-orders-detail-item col-xs-3">@Model.Status</div>
            </div>
        </div>

        <div class="esh-orders-detail-section">
            <div class="esh-orders-detail-titles row">
                <div class="esh-orders-detail-title col-xs-12">Shipping Address</div>
            </div>

            <div class="esh-orders-detail-items row">
                <div class="esh-orders-detail-item col-xs-12">@Model.ShippingAddress?.Street</div>
            </div>

            <div class="esh-orders-detail-items row">
                <div class="esh-orders-detail-item col-xs-12">@Model.ShippingAddress?.City</div>
            </div>

            <div class="esh-orders-detail-items row">
                <div class="esh-orders-detail-item col-xs-12">@Model.ShippingAddress?.Country</div>
            </div>
        </div>

        <div class="esh-orders-detail-section">
            <div class="esh-orders-detail-titles row">
                <div class="esh-orders-detail-title col-xs-12">ORDER DETAILS</div>
            </div>

            @for (int i = 0; i < Model.OrderItems.Count; i++)
            {
                var item = Model.OrderItems[i];
                <div class="esh-orders-detail-items esh-orders-detail-items--border row">
                    <div class="esh-orders-detail-item col-md-4 hidden-md-down">
                        <img class="esh-orders-detail-image" src="@item.PictureUrl" />
                    </div>
                    <div class="esh-orders-detail-item esh-orders-detail-item--middle col-xs-3">@item.ProductName</div>
                    <div class="esh-orders-detail-item esh-orders-detail-item--middle col-xs-1">$ @item.UnitPrice.ToString("N2")</div>
                    <div class="esh-orders-detail-item esh-orders-detail-item--middle col-xs-1">@item.Units</div>
                    <div class="esh-orders-detail-item esh-orders-detail-item--middle col-xs-2">$ @Math.Round(item.Units * item.UnitPrice, 2).ToString("N2")</div>
                </div>
            }
        </div>

        <div class="esh-orders-detail-section esh-orders-detail-section--right">
            <div class="esh-orders-detail-titles esh-basket-titles--clean row">
                <div class="esh-orders-detail-title col-xs-9"></div>
                <div class="esh-orders-detail-title col-xs-2">TOTAL</div>
            </div>

            <div class="esh-orders-detail-items row">
                <div class="esh-orders-detail-item col-xs-9"></div>
                <div class="esh-orders-detail-item esh-orders-detail-item--mark col-xs-2">$ @Model.Total.ToString("N2")</div>
            </div>
        </div>
    </div>
</div>
