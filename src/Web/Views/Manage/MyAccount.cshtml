@model IndexViewModel
@{
    ViewData["Title"] = "Profile";
    ViewData.AddActivePage(ManageNavPages.Index);
}

<h4>@ViewData["Title"]</h4>
<partial name="_StatusMessage" model="@Model.StatusMessage" />
<div class="row">
    <div class="col-md-6">
        <form method="post">
            @Html.ValidationSummary(false, null, new { @class = "text-danger" })
            <div class="form-group">
                @Html.LabelFor(m => m.Username)
                <input type="text" id="Username" name="Username" value="@Model.Username" class="form-control" disabled />
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.Email)
                @if (Model.IsEmailConfirmed)
                {
                <div class="input-group">
                    <input type="email" id="Email" name="Email" value="@Model.Email" class="form-control" />
                    <span class="input-group-addon" aria-hidden="true"><span class="glyphicon glyphicon-ok text-success"></span></span>
                </div>
                }
                else
                {
                <input type="email" id="Email" name="Email" value="@Model.Email" class="form-control" />
                <button asp-action="SendVerificationEmail" class="btn btn-link">Send verification email</button>
                }
                @Html.ValidationMessage("Email", null, new { @class = "text-danger" })
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.PhoneNumber)
                <input type="tel" id="PhoneNumber" name="PhoneNumber" value="@Model.PhoneNumber" class="form-control" />
                @Html.ValidationMessage("PhoneNumber", null, new { @class = "text-danger" })
            </div>
            <button type="submit" class="btn btn-default">Save</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
