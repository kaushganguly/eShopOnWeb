<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">	
	<PropertyGroup>
		<!-- Clear the default set in Directory.Build.props so TargetFrameworks enables multi-targeting.
		     Primary TFM is net10.0 for the actual WASM browser output.
		     net8.0 is included so Web (still net8.0) can hold a project reference
		     to this app during the mixed-target coexistence phase. -->
		<TargetFramework />
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
	</PropertyGroup>

	<!-- net8.0 slice: use 8.x package versions; these packages are net10.0-only in their 10.x releases -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.Authorization" VersionOverride="8.0.2" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" VersionOverride="8.0.2" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" VersionOverride="8.0.2" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" VersionOverride="8.0.2" />
		<PackageReference Include="Microsoft.Extensions.Identity.Core" VersionOverride="8.0.2" />
	</ItemGroup>

	<!-- net10.0 slice: upgraded package versions from Directory.Packages.props (BlazorWasmVersion=10.0.9) -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" />
		<PackageReference Include="Microsoft.Extensions.Identity.Core" />
	</ItemGroup>

	<!-- Packages compatible with both net8.0 and net10.0 -->
	<ItemGroup>
		<PackageReference Include="Blazored.LocalStorage" />
		<PackageReference Include="BlazorInputFile" />
		<PackageReference Include="Microsoft.Extensions.Logging.Configuration" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BlazorShared\BlazorShared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Services\CatalogItem\Delete.EditCatalogItemResult.cs">
			<DependentUpon>Delete.cs</DependentUpon>
		</Compile>
		<Compile Update="Services\CatalogItem\GetById.EditCatalogItemResult.cs">
			<DependentUpon>GetById.cs</DependentUpon>
		</Compile>
		<Compile Update="Services\CatalogItem\Edit.CreateCatalogItemResult.cs">
			<DependentUpon>Edit.cs</DependentUpon>
		</Compile>
	</ItemGroup>

</Project>
